// app/api/dishes/route.ts
import { NextResponse } from 'next/server';
import prisma from '@/lib/prisma';

export async function GET(request: Request) {
  try {
    console.log('[Dishes API] ===== NEW REQUEST =====');
    console.log('[Dishes API] Request URL:', request.url);

    return NextResponse.json({ message: 'API is working', timestamp: new Date().toISOString() }, { status: 200 });
    let dishes = [];

    // Спочатку перевіряємо, чи це назва головної категорії
    console.log(`[Dishes API] Checking category: "${categoryName}"`);
    if (categoryName === 'Їжа') {
      console.log('[Dishes API] Getting dishes for Їжа category');
      // Повертаємо всі страви з підкатегорій їжі
      dishes = await prisma.dish.findMany({
        where: {
          category: {
            parent: {
              name: 'Їжа',
              restaurantId: numericRestaurantId
            }
          }
        }
      });
      console.log(`[Dishes API] Found ${dishes.length} dishes for Їжа`);
    } else if (categoryName === 'Напої') {
      console.log('[Dishes API] Getting dishes for Напої category');
      // Повертаємо всі страви з підкатегорій напоїв
      dishes = await prisma.dish.findMany({
        where: {
          category: {
            parent: {
              name: 'Напої',
              restaurantId: numericRestaurantId
            }
          }
        }
      });
      console.log(`[Dishes API] Found ${dishes.length} dishes for Напої`);
    } else if (categoryName === 'Алкоголь') {
      console.log('[Dishes API] Getting dishes for Алкоголь category');
      // Повертаємо всі страви з підкатегорій алкоголю
      dishes = await prisma.dish.findMany({
        where: {
          category: {
            parent: {
              name: 'Алкоголь',
              restaurantId: numericRestaurantId
            }
          }
        }
      });
      console.log(`[Dishes API] Found ${dishes.length} dishes for Алкоголь`);
    } else if (categoryName === 'Мерч') {
      console.log('[Dishes API] Getting dishes for Мерч category');
      // Повертаємо всі страви з підкатегорій мерчу
      dishes = await prisma.dish.findMany({
        where: {
          category: {
            parent: {
              name: 'Мерч',
              restaurantId: numericRestaurantId
            }
          }
        }
      });
      console.log(`[Dishes API] Found ${dishes.length} dishes for Мерч`);
    } else {
      console.log(`[Dishes API] Getting dishes for subcategory: "${categoryName}"`);
      // Шукаємо в конкретній субкатегорії
      dishes = await prisma.dish.findMany({
        where: {
          category: {
            name: categoryName,
            restaurantId: numericRestaurantId,
            parentId: { not: null } // Тільки підкатегорії
          }
        }
      });
      console.log(`[Dishes API] Found ${dishes.length} dishes for subcategory "${categoryName}"`);
    }

    console.log(`[Dishes API] Returning ${dishes.length} dishes total`);
    return NextResponse.json(dishes, { status: 200 });
  } catch (error) {
    console.error('Error fetching dishes:', error);
    return NextResponse.json(
      { error: 'Internal Server Error' },
      { status: 500 }
    );
  }
}
