// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  OWNER
}

// --- ОНОВЛЕНА Модель Користувача ---
model User {
  id            Int      @id @default(autoincrement())
  name          String?  // Google надасть ім'я
  email         String?  @unique // Email може бути null доки не верифіковано
  emailVerified DateTime?
  image         String?  // Google надасть фото профілю
  password      String?  // Пароль стає опціональним (для Google входу він не потрібен)

  role      Role     @default(CUSTOMER)
  level     Int      @default(1)
  progress  Int      @default(0)

  // Зв'язки NextAuth
  accounts Account[]
  sessions Session[]

  // Ваші зв'язки
  restaurants Restaurant[]
  orders      Order[]
  userRestaurantStats UserRestaurantStats[]
  comments    Comment[]
  reservations Reservation[]
  userAchievements UserAchievement[]
}

// --- НОВІ МОДЕЛІ ДЛЯ NEXT-AUTH ---
model Account {
  id                 Int       @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- НОВІ МОДЕЛІ ---
model UserRestaurantStats {
  id           Int @id @default(autoincrement())
  userId       Int
  restaurantId Int
  xp           Int @default(0) // Досвід

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

enum CategoryType {
  KITCHEN // Кухня
  DRINKS  // Напої (безалкогольні)
  ALCOHOL // Алкоголь
  MERCH   // Мерч/Інше
}

// --- Ваші існуючі моделі ---
model Restaurant {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  bannerUrl   String?
  logoUrl     String?
  address     String?
  stars       Float?
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  categories  Category[]
  orders      Order[]
  userRestaurantStats UserRestaurantStats[]
  tables      Table[]
  reservations Reservation[]
}
model Category {
  id           Int     @id @default(autoincrement())
  name         String
  description  String?

  // Category hierarchy
  type         CategoryType @default(KITCHEN)
  parentId     Int?  // Parent category ID for subcategories
  parent       Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryHierarchy")

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  dishes       Dish[]
}

model Dish {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  calories    Int?
  allergens   String? // JSON string або comma-separated список алергенів
  imageUrl    String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  comments    Comment[]
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id           Int         @id @default(autoincrement())
  createdAt    DateTime    @default(now())
  totalPrice   Float
  status       OrderStatus @default(PENDING)
  tableNumber  String?
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  items        OrderItem[]
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  quantity       Int
  priceAtPurchase Float  // Ціна на момент покупки
  orderId        Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId         Int
  dish           Dish    @relation(fields: [dishId], references: [id])
}

model Achievement {
  id          Int    @id @default(autoincrement())
  code        String @unique
  name        String
  description String
  iconUrl     String?
  userAchievements UserAchievement[]
}

model UserAchievement {
  id           Int       @id @default(autoincrement())
  userId       Int
  achievementId Int
  unlockedAt   DateTime  @default(now())
  
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement  Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  userId    Int
  dishId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
  @@index([userId])
}

enum TableStatus {
  FREE      // Вільний
  OCCUPIED  // Зайнятий
  RESERVED  // Заброньований
}

model Table {
  id           Int         @id @default(autoincrement())
  number       String      // Номер столика (може бути будь-який формат: "1", "A1", "VIP-1" тощо)
  qrCodeUrl    String?     // URL QR коду (генерується на сервері)
  status       TableStatus @default(FREE) // Статус столика
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, number])
}

model Reservation {
  id           Int      @id @default(autoincrement())
  tableId      Int
  table        Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       Int?     // ID користувача, який створив бронювання (опціонально для гостей)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reservedAt   DateTime // Час на який заброньовано
  createdAt    DateTime @default(now())
  customerName String?  // Ім'я клієнта (опціонально)
  customerPhone String? // Телефон клієнта (опціонально)
  notes        String?  // Додаткові нотатки

  @@index([restaurantId])
  @@index([tableId])
  @@index([userId])
}